# Copy to .env in the project root and fill in your own credentials.
# SQL Server continues using application.properties unless you override it here.
# spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=webst_combined;encrypt=false;trustServerCertificate=true
# spring.datasource.username=sa
# spring.datasource.password=YOUR_DATABASE_PASSWORD
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional; defaults to MAIL_USERNAME
# MAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
